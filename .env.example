# ==========================================================================
# BotLeilão — Variáveis de ambiente raiz (copie para .env e ajuste)
# ==========================================================================

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=botleilao
POSTGRES_PASSWORD=botleilao_secret
POSTGRES_DB=botleilao
DATABASE_URL=postgresql://botleilao:botleilao_secret@localhost:5433/botleilao?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Backend API ------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_HOST=http://localhost:3000

# --- JWT -------------------------------------------------------------------
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-em-producao
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@botleilao.com.br
SEED_ADMIN_PASSWORD=Admin@12345

# --- WhatsApp ---------------------------------------------------------------
# Caminho de um navegador Chromium/Chrome instalado (usado quando o Chromium
# do puppeteer não foi baixado). Deixe vazio para usar o navegador padrão.
WHATSAPP_BROWSER_PATH=
