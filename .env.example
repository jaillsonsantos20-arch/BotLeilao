# ==========================================================================
# BotLeilão — Variáveis de ambiente raiz (copie para .env e ajuste)
# ==========================================================================

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=botleilao
POSTGRES_PASSWORD=botleilao_secret
POSTGRES_DB=botleilao
DATABASE_URL=postgresql://botleilao:botleilao_secret@localhost:5433/botleilao?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=troque-por-uma-senha-forte-do-redis

# --- Backend API ------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_HOST=http://localhost:3000
# True apenas quando o site estiver atrás de HTTPS (cookie Secure)
COOKIE_SECURE=false

# --- JWT -------------------------------------------------------------------
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte-em-producao
JWT_REFRESH_EXPIRES_IN=7d

# --- E-mail (SMTP) -----------------------------------------------------------
# URL pública do frontend usada nos links de redefinição/verificação.
# Em desenvolvimento, com SMTP vazio, os e-mails são logados no console.
FRONTEND_URL=http://localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BotLeilão <no-reply@botleilao.com>

# --- Seed ------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@botleilao.com.br
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte-do-admin

# --- Mercado Pago -----------------------------------------------------------
# Access token de PRODUÇÃO (gerado em mercadopago.com.br/developers).
# Sem ele, POST /api/payments/pix retorna 503.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-000000000000000000000000000000-0000000000
# URL pública HTTPS do webhook (obrigatória em produção).
# Ex.: https://api.exemplo.com/api/payments/webhook
# Em dev/localhost o MP não alcança você: use um túnel (ngrok/cloudflared)
# ou use o botão "Já paguei" do paywall (POST /api/payments/sync).
MERCADOPAGO_NOTIFICATION_URL=
# Secret HMAC do webhook (mesmo valor cadastrado no painel do MP).
# Sem ele, todo webhook é rejeitado com 401 (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=troque-por-um-segredo-forte-do-webhook

# --- WhatsApp ---------------------------------------------------------------
# Caminho de um navegador Chromium/Chrome instalado (usado quando o Chromium
# do puppeteer não foi baixado). Deixe vazio para usar o navegador padrão.
WHATSAPP_BROWSER_PATH=

# --- Speech-to-Text (lances por áudio) ---------------------------------------
# Opcional. Sem chave, o bot ignora áudios e pede para digitar o lance.
# Provedor: "openai-compatible" (OpenAI, Groq ou endpoint local compatível)
# ou "disabled" para desligar na marra. Deixar PROVIDER vazio já desliga.
SPEECH_TO_TEXT_PROVIDER=
# Chave do provedor (obrigatória quando PROVIDER != disabled).
# OpenAI: https://platform.openai.com/api-keys | Groq: https://console.groq.com/keys
SPEECH_TO_TEXT_API_KEY=
# Base URL do provedor (sem /audio/transcriptions, o serviço acrescenta).
# OpenAI: https://api.openai.com/v1 | Groq: https://api.groq.com/openai/v1
SPEECH_TO_TEXT_BASE_URL=https://api.openai.com/v1
SPEECH_TO_TEXT_MODEL=whisper-1
SPEECH_TO_TEXT_LANGUAGE=pt
# Contexto enviado ao Whisper (opcional, máx. 224 tokens). Vazio = usa o padrão
# de leilão em pt-BR, que evita erro em números por extenso ("trezentos" não
# vira "Presentes"). Use "none" para não enviar contexto algum.
SPEECH_TO_TEXT_PROMPT=
# Limites de segurança: nada além disso sai do caminho de recepção.
SPEECH_TO_TEXT_TIMEOUT_MS=20000
SPEECH_TO_TEXT_MAX_AUDIO_MB=8
SPEECH_TO_TEXT_MAX_DURATION_SECONDS=180

# --- Frontend (Vite) ----------------------------------------------------------
# URL do botão de suporte flutuante da landing page.
# Ex.: VITE_SUPPORT_WHATSAPP_URL=https://wa.me/5586999696897?text=Ol%C3%A1...
VITE_SUPPORT_WHATSAPP_URL=https://wa.me/5586999696897?text=Ol%C3%A1!%20Preciso%20de%20ajuda%20com%20o%20LanceZap.
